{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "lib": ["ES2022", "DOM"],
    "moduleResolution": "bundler",
    "jsx": "react",
    "skipLibCheck": true,
    "allowArbitraryExtensions": true,
    "types": ["vitest/globals", "react", "vite/client"],
    "resolveJsonModule": true,
    "strict": false,
    "noImplicitAny": true,
    "noEmit": true
  },
  "include": ["src/**/*", ".storybook/**/*", "*.ts"],
  "exclude": ["node_modules", "dist", "scripts"]
}
