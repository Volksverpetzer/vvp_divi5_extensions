{
  "name": "vvp-divi-5-extensions",
  "version": "1.0.3",
  "description": "DIVI 5 extension for the vvp wordpress site",
  "private": true,
  "packageManager": "pnpm@11.5.2",
  "author": "Volksverpetzer",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=22.22.1"
  },
  "scripts": {
    "start": "NODE_ENV=development node build.mjs --watch",
    "build": "NODE_ENV=production node build.mjs",
    "preview": "vite",
    "build:preview": "vite build --base=/vvp_divi5_extensions/",
    "zip": "gulp zip",
    "---- check test and lint ----": "-------------",
    "check": "pnpm check:spelling && pnpm check:ts",
    "check:spelling": "cspell lint",
    "check:ts": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "------- other scripts -------": "-------------",
    "prepare": "husky",
    "update:deps": "pnpx npm-check-updates -c 1d -i --format group"
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.2",
    "@divi/module": "^1.0.7",
    "@divi/module-library": "^1.0.7",
    "@divi/types": "^1.0.6",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.24",
    "@types/react": "19.2.16",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^6.0.2",
    "@vitest/coverage-v8": "^4.1.8",
    "@wordpress/hooks": "^4.47.0",
    "@wordpress/i18n": "^6.20.0",
    "autoprefixer": "^10.5.0",
    "cspell": "^10.0.1",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.6.0",
    "gulp": "^5.0.1",
    "gulp-zip": "^6.1.0",
    "happy-dom": "^20.10.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "lodash": "^4.18.1",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "sass": "^1.100.0",
    "typescript": "^6.0.3",
    "vite": "^8.0.16",
    "vitest": "^4.1.8"
  }
}
