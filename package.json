{
  "name": "vvp-divi-5-extensions",
  "version": "1.0.2",
  "description": "DIVI 5 extension for the vvp wordpress site",
  "private": true,
  "packageManager": "pnpm@11.5.1",
  "author": "Volksverpetzer",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=22.22.1"
  },
  "scripts": {
    "start": "NODE_ENV=development webpack -w --config webpack.config.js --progress",
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "preview": "vite",
    "zip": "gulp zip",
    "---- check test and lint ----": "-------------",
    "check": "pnpm check:spelling && pnpm check:ts",
    "check:spelling": "cspell lint",
    "check:ts": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "------- other scripts -------": "-------------",
    "prepare": "husky",
    "update:deps": "pnpx npm-check-updates -c 1d -i --format group"
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@babel/plugin-transform-class-properties": "^7.29.7",
    "@babel/plugin-transform-runtime": "^7.29.7",
    "@babel/preset-env": "^7.29.7",
    "@babel/preset-react": "^7.29.7",
    "@babel/preset-typescript": "^7.29.7",
    "@divi/module": "^1.0.7",
    "@divi/module-library": "^1.0.7",
    "@divi/types": "^1.0.6",
    "@eslint/eslintrc": "^3.3.5",
    "@eslint/js": "^9.39.4",
    "@types/lodash": "^4.17.24",
    "@types/react": "19.2.16",
    "@types/react-dom": "17.0.14",
    "@typescript-eslint/eslint-plugin": "^8.60.1",
    "@typescript-eslint/parser": "^8.60.1",
    "@vitejs/plugin-react": "^4.7.0",
    "@wordpress/hooks": "^3.58.0",
    "@wordpress/i18n": "^4.58.0",
    "@cspell/dict-de-de": "^4.1.2",
    "@testing-library/react": "^16.3.2",
    "@vitest/coverage-v8": "^3.2.4",
    "autoprefixer": "^10.5.0",
    "babel-loader": "^9.2.1",
    "copy-webpack-plugin": "^12.0.2",
    "cspell": "^10.0.1",
    "css-loader": "^7.1.4",
    "eslint": "^9.39.4",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^17.6.0",
    "gulp": "^5.0.1",
    "gulp-zip": "^6.1.0",
    "happy-dom": "^18.0.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.0.7",
    "lodash": "^4.18.1",
    "mini-css-extract-plugin": "^2.10.2",
    "postcss": "^8.5.15",
    "prettier": "^3.8.3",
    "react": "^19.2.7",
    "react-dom": "^18.3.1",
    "sass": "^1.100.0",
    "sass-loader": "^14.2.1",
    "style-loader": "^4.0.0",
    "ts-loader": "^9.6.0",
    "typescript": "^5.9.3",
    "vite": "^6.4.3",
    "vitest": "^3.2.4",
    "webpack": "^5.107.2",
    "webpack-cli": "^5.1.4"
  }
}
