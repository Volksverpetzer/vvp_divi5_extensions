{
  "name": "vvp-divi5-extensions",
  "version": "1.6.0",
  "description": "DIVI 5 extension for the vvp wordpress site",
  "private": true,
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@12.18.0",
  "author": "Volksverpetzer",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=development node build.mjs --watch",
    "build": "NODE_ENV=production node build.mjs",
    "build:dev": "NODE_ENV=development node build.mjs",
    "preview": "storybook dev -p 8899",
    "build:preview": "storybook build --output-dir preview/dist",
    "zip": "node zip.mjs",
    "---- check test and lint ----": "-------------",
    "check": "pnpm check:spelling && pnpm check:ts",
    "check:spelling": "cspell lint",
    "check:ts": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "------- other scripts -------": "-------------",
    "prepare": "husky",
    "postinstall": "node -e \"try { require('fs').chmodSync('node_modules/prettier/bin/prettier.cjs', 0o755) } catch {}\"",
    "update:deps": "pnpx npm-check-updates -c 1d -i --format group"
  },
  "dependencies": {
    "@stripe/stripe-js": "^10.2.1",
    "@volksverpetzer/design-tokens": "0.10.0",
    "@volksverpetzer/ui-web": "0.17.0",
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.3",
    "@divi/module": "^1.0.14",
    "@divi/module-library": "^1.0.15",
    "@divi/types": "^1.0.13",
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "^10.6.6",
    "@testing-library/react": "^16.3.3",
    "@types/lodash": "^4.17.27",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@typescript-eslint/eslint-plugin": "^8.72.1",
    "@typescript-eslint/parser": "^8.72.1",
    "@vitejs/plugin-react": "^6.3.0",
    "@vitest/coverage-v8": "^5.1.0",
    "@wordpress/hooks": "^5.1.0",
    "@wordpress/i18n": "^7.1.0",
    "autoprefixer": "^10.6.2",
    "cspell": "^10.4.1",
    "eslint": "^10.14.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.7",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "happy-dom": "^21.0.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "lodash": "^4.18.1",
    "postcss": "^8.5.32",
    "prettier": "^3.9.10",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "storybook": "^10.6.6",
    "typescript": "^6.0.3",
    "vite": "^8.3.7",
    "vitest": "^5.1.0"
  }
}
