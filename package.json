{
  "name": "vvp-divi5-extensions",
  "version": "1.0.7",
  "description": "DIVI 5 extension for the vvp wordpress site",
  "private": true,
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@11.17.0",
  "author": "Volksverpetzer",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=22.22.1"
  },
  "scripts": {
    "start": "NODE_ENV=development node build.mjs --watch",
    "build": "NODE_ENV=production node build.mjs",
    "build:dev": "NODE_ENV=development node build.mjs",
    "preview": "vite",
    "build:preview": "vite build --base=/vvp_divi5_extensions/",
    "zip": "node zip.mjs",
    "---- check test and lint ----": "-------------",
    "check": "pnpm check:spelling && pnpm check:ts",
    "check:spelling": "cspell lint",
    "check:ts": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "------- other scripts -------": "-------------",
    "prepare": "husky",
    "postinstall": "node -e \"try { require('fs').chmodSync('node_modules/prettier/bin/prettier.cjs', 0o755) } catch {}\"",
    "update:deps": "pnpx npm-check-updates -c 1d -i --format group"
  },
  "dependencies": {
    "@stripe/stripe-js": "^8.5.3",
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.2",
    "@divi/module": "^1.0.10",
    "@divi/module-library": "^1.0.10",
    "@divi/types": "^1.0.9",
    "@eslint/js": "^10.0.1",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.24",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/coverage-v8": "^4.1.10",
    "@wordpress/hooks": "^4.51.0",
    "@wordpress/i18n": "^6.24.0",
    "autoprefixer": "^10.5.4",
    "cspell": "^10.0.1",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.7.0",
    "happy-dom": "^20.11.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "lodash": "^4.18.1",
    "postcss": "^8.5.23",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sass": "^1.102.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  }
}
