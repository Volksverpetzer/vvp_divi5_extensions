{
  "name": "vvp-divi-5-extensions",
  "version": "1.0.1",
  "description": "DIVI 5 extension for the vvp wordpress site",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "author": "Volksverpetzer",
  "engines": {
    "npm": ">=10.0.0",
    "node": ">=22.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=development webpack -w --config webpack.config.js --progress",
    "build": "NODE_ENV=production webpack --config webpack.config.js --progress",
    "preview": "vite",
    "zip": "gulp zip",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "classnames": "^2.5.1"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "esbuild"
