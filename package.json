{
  "name": "vvp-divi5-extensions",
  "version": "1.3.0",
  "description": "DIVI 5 extension for the vvp wordpress site",
  "private": true,
  "license": "GPL-2.0-or-later",
  "packageManager": "pnpm@11.24.0",
  "author": "Volksverpetzer",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "start": "NODE_ENV=development node build.mjs --watch",
    "build": "NODE_ENV=production node build.mjs",
    "build:dev": "NODE_ENV=development node build.mjs",
    "preview": "storybook dev -p 8899",
    "build:preview": "storybook build --output-dir preview/dist",
    "zip": "node zip.mjs",
    "---- check test and lint ----": "-------------",
    "check": "pnpm check:spelling && pnpm check:ts",
    "check:spelling": "cspell lint",
    "check:ts": "tsc --noEmit",
    "test": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "------- other scripts -------": "-------------",
    "prepare": "husky",
    "postinstall": "node -e \"try { require('fs').chmodSync('node_modules/prettier/bin/prettier.cjs', 0o755) } catch {}\"",
    "update:deps": "pnpx npm-check-updates -c 1d -i --format group"
  },
  "dependencies": {
    "@stripe/stripe-js": "^9.14.0",
    "@volksverpetzer/design-tokens": "0.6.0",
    "@volksverpetzer/ui-web": "0.8.0",
    "classnames": "^2.5.1"
  },
  "devDependencies": {
    "@cspell/dict-de-de": "^4.1.2",
    "@divi/module": "^1.0.13",
    "@divi/module-library": "^1.0.13",
    "@divi/types": "^1.0.11",
    "@eslint/js": "^10.0.1",
    "@storybook/react-vite": "^10.5.10",
    "@testing-library/react": "^16.3.2",
    "@types/lodash": "^4.17.25",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.5",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "@vitejs/plugin-react": "^6.1.0",
    "@vitest/coverage-v8": "^4.1.11",
    "@wordpress/hooks": "^4.54.0",
    "@wordpress/i18n": "^6.27.0",
    "autoprefixer": "^10.5.4",
    "cspell": "^10.1.1",
    "eslint": "^10.9.1",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.11.0",
    "happy-dom": "^20.11.8",
    "husky": "^9.1.7",
    "lint-staged": "^17.3.0",
    "lodash": "^4.18.1",
    "postcss": "^8.5.26",
    "prettier": "^3.9.6",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "typescript": "^6.0.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  }
}
