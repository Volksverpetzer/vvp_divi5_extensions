{
  "name": "vvp/campaign-progress",
  "d4Shortcode": "",
  "title": "Spendenfortschritt",
  "titles": "Spendenfortschritt",
  "moduleIcon": "vvp/campaign-progress-icon",
  "moduleClassName": "campaign_progress",
  "moduleOrderClassName": "campaign_progress",
  "category": "module",
  "attributes": {
    "module": {
      "type": "object",
      "selector": "{{selector}}",
      "styleProps": {
        "border": {
          "important": true
        }
      },
      "settings": {
        "meta": {
          "adminLabel": {}
        },
        "advanced": {
          "link": {},
          "text": {},
          "htmlAttributes": {}
        },
        "decoration": {
          "attributes": {},
          "background": {},
          "sizing": {},
          "spacing": {},
          "border": {},
          "boxShadow": {},
          "filters": {},
          "transform": {},
          "animation": {},
          "overflow": {},
          "disabledOn": {},
          "transition": {},
          "position": {},
          "zIndex": {},
          "scroll": {},
          "sticky": {}
        }
      }
    },
    "headline": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "mainContent",
            "priority": 5,
            "render": true,
            "attrName": "headline.innerContent",
            "label": "Überschrift (optional)",
            "description": "Wird über dem Fortschrittsbalken angezeigt. Platzhalter für die Zahlen des Balkens: {gesammelt} (bisher gesammelt), {ziel} (Spendenziel), {fehlt} (bis zum Ziel), {prozent} (Anteil am Ziel), z. B. „Schon {gesammelt} von {ziel} gesammelt!“. Die Zahlen aktualisieren sich mit dem Balken. Text in <small>…</small> wird kleiner, grau und nicht fett angezeigt, z. B. „Monatlich: {gesammelt} <small>von {ziel}</small>“; anderes HTML wird als Text angezeigt. Mit Überschrift wird die Zeile „7.340 € von 20.000 €“ über dem Balken ausgeblendet. Leer lassen, um keine Überschrift anzuzeigen (dann bleibt die Zeile).",
            "features": {
              "sticky": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    },
    "summaryApiUrl": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "mainContent",
            "priority": 10,
            "render": true,
            "attrName": "summaryApiUrl.innerContent",
            "label": "Fortschritts-API URL",
            "description": "GET-Endpunkt der Kampagne. Erwartet JSON { totalRaised: number, goal?: number }.",
            "features": {
              "sticky": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    },
    "goal": {
      "type": "object",
      "settings": {
        "innerContent": {
          "groupType": "group-item",
          "item": {
            "groupName": "mainContent",
            "priority": 20,
            "render": true,
            "attrName": "goal.innerContent",
            "label": "Ziel in € (Fallback)",
            "description": "Wird nur verwendet, solange die API kein eigenes Ziel liefert oder nicht erreichbar ist.",
            "features": {
              "sticky": false,
              "dynamicContent": false
            },
            "component": {
              "name": "divi/text",
              "type": "field"
            }
          }
        }
      }
    }
  },
  "settings": {
    "content": "auto",
    "design": "auto",
    "advanced": "auto"
  }
}
