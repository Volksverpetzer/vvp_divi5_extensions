{
    "name": "vvp/instagram-slideshow",
    "d4Shortcode": "",
    "title": "Instagram Slideshow",
    "titles": "Instagram Slideshows",
    "moduleIcon": "vvp/instagram-slideshow-icon",
    "moduleClassName": "instagram_slideshow",
    "moduleOrderClassName": "instagram_slideshow",
    "category": "module",
    "attributes": {
        "module": {
            "type": "object",
            "selector": "{{selector}}",
            "styleProps": {
                "border": {
                    "important": true
                }
            },
            "settings": {
                "meta": {
                    "adminLabel": {}
                },
                "advanced": {
                    "link": {},
                    "text": {},
                    "htmlAttributes": {}
                },
                "decoration": {
                    "attributes": {},
                    "background": {},
                    "sizing": {},
                    "spacing": {},
                    "border": {},
                    "boxShadow": {},
                    "filters": {},
                    "transform": {},
                    "animation": {},
                    "overflow": {},
                    "disabledOn": {},
                    "transition": {},
                    "position": {},
                    "zIndex": {},
                    "scroll": {},
                    "sticky": {}
                }
            }
        },
        "useLatest": {
            "type": "object",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupName": "mainContent",
                        "priority": 5,
                        "render": true,
                        "attrName": "useLatest.innerContent",
                        "label": "Use Latest Post Index",
                        "description": "Use latest posts feed instead of a specific post ID",
                        "features": {
                            "sticky": false,
                            "dynamicContent": false
                        },
                        "component": {
                            "name": "divi/toggle",
                            "type": "field"
                        }
                    }
                }
            }
        },
        "latestIndex": {
            "type": "object",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupName": "mainContent",
                        "priority": 8,
                        "render": true,
                        "attrName": "latestIndex.innerContent",
                        "label": "Latest Post Index",
                        "description": "1 = newest, 2 = previous, etc (max 20)",
                        "features": {
                            "sticky": false,
                            "dynamicContent": false
                        },
                        "component": {
                            "name": "divi/range",
                            "type": "field",
                            "props": {
                                "min": 1,
                                "max": 20,
                                "step": 1
                            }
                        }
                    }
                }
            }
        },
        "postId": {
            "type": "object",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupName": "mainContent",
                        "priority": 10,
                        "render": true,
                        "attrName": "postId.innerContent",
                        "label": "Instagram Post ID",
                        "description": "Enter the Instagram post ID (e.g., 17881655640351114)",
                        "features": {
                            "sticky": false,
                            "dynamicContent": false
                        },
                        "component": {
                            "name": "divi/text",
                            "type": "field"
                        }
                    }
                }
            }
        },
        "apiBaseUrl": {
            "type": "object",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupName": "mainContent",
                        "priority": 20,
                        "render": true,
                        "attrName": "apiBaseUrl.innerContent",
                        "label": "API Base URL",
                        "description": "Base URL for Instagram API proxy",
                        "features": {
                            "sticky": false,
                            "dynamicContent": false
                        },
                        "component": {
                            "name": "divi/text",
                            "type": "field"
                        }
                    }
                }
            }
        },
        "showCaption": {
            "type": "object",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupName": "displaySettings",
                        "priority": 10,
                        "render": true,
                        "attrName": "showCaption.innerContent",
                        "label": "Show Caption",
                        "description": "Display the Instagram post caption below the slideshow",
                        "features": {
                            "sticky": false,
                            "dynamicContent": false
                        },
                        "component": {
                            "name": "divi/toggle",
                            "type": "field"
                        }
                    }
                }
            }
        },
        "showNavigation": {
            "type": "object",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupName": "displaySettings",
                        "priority": 20,
                        "render": true,
                        "attrName": "showNavigation.innerContent",
                        "label": "Show Navigation Arrows",
                        "description": "Display previous/next navigation arrows",
                        "features": {
                            "sticky": false,
                            "dynamicContent": false
                        },
                        "component": {
                            "name": "divi/toggle",
                            "type": "field"
                        }
                    }
                }
            }
        },
        "showPagination": {
            "type": "object",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupName": "displaySettings",
                        "priority": 30,
                        "render": true,
                        "attrName": "showPagination.innerContent",
                        "label": "Show Pagination Dots",
                        "description": "Display pagination dots for each slide",
                        "features": {
                            "sticky": false,
                            "dynamicContent": false
                        },
                        "component": {
                            "name": "divi/toggle",
                            "type": "field"
                        }
                    }
                }
            }
        },
        "autoplay": {
            "type": "object",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupName": "slideshowSettings",
                        "priority": 10,
                        "render": true,
                        "attrName": "autoplay.innerContent",
                        "label": "Autoplay",
                        "description": "Automatically advance to the next slide",
                        "features": {
                            "sticky": false,
                            "dynamicContent": false
                        },
                        "component": {
                            "name": "divi/toggle",
                            "type": "field"
                        }
                    }
                }
            }
        },
        "transitionSpeed": {
            "type": "object",
            "settings": {
                "innerContent": {
                    "groupType": "group-item",
                    "item": {
                        "groupName": "slideshowSettings",
                        "priority": 20,
                        "render": true,
                        "attrName": "transitionSpeed.innerContent",
                        "label": "Transition Speed (seconds)",
                        "description": "Time between slide transitions (1-10 seconds)",
                        "features": {
                            "sticky": false,
                            "dynamicContent": false
                        },
                        "component": {
                            "name": "divi/range",
                            "type": "field",
                            "props": {
                                "min": 1,
                                "max": 10,
                                "step": 1
                            }
                        }
                    }
                }
            }
        }
    },
    "settings": {
        "content": "auto",
        "design": "auto",
        "advanced": "auto",
        "groups": {
            "displaySettings": {
                "panel": "content",
                "priority": 20,
                "groupName": "displaySettings",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Display Settings"
                    }
                }
            },
            "slideshowSettings": {
                "panel": "design",
                "priority": 10,
                "groupName": "slideshowSettings",
                "multiElements": true,
                "component": {
                    "name": "divi/composite",
                    "props": {
                        "groupLabel": "Slideshow Settings"
                    }
                }
            }
        }
    }
}
